{
  "name": "iot-platform-mqtt",
  "version": "1.0.0",
  "description": "Production-ready MQTT broker integration for IoT Platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:clustering": "./scripts/run-tests.sh clustering",
    "test:security": "./scripts/run-tests.sh security",
    "test:pipeline": "./scripts/run-tests.sh pipeline",
    "test:performance": "./scripts/run-tests.sh performance",
    "test:monitoring": "./scripts/run-tests.sh monitoring",
    "verify": "./scripts/verify-implementation.sh",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "mqtt",
    "iot",
    "broker",
    "mosquitto",
    "emqx"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "mqtt": "^5.3.5",
    "async-mqtt": "^2.6.3",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "prom-client": "^15.1.0",
    "bull": "^4.12.0",
    "ioredis": "^5.3.2",
    "protobufjs": "^7.2.5",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "express": "^4.18.2",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "@types/uuid": "^9.0.7",
    "@types/lodash": "^4.14.202",
    "@types/jest": "^29.5.11",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "axios": "^1.6.5",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
