# MQTT Broker Configuration
MQTT_BROKER_TYPE=mosquitto
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_BROKER_WS_URL=ws://localhost:8883
MQTT_PROTOCOL_VERSION=5
MQTT_CLIENT_ID_PREFIX=iot-platform

# MQTT Clustering (for EMQX)
MQTT_CLUSTER_ENABLED=false
MQTT_CLUSTER_NODES=mqtt1.example.com:1883,mqtt2.example.com:1883

# TLS/SSL Configuration
MQTT_TLS_ENABLED=false
MQTT_TLS_CA_PATH=./certs/ca.crt
MQTT_TLS_CERT_PATH=./certs/client.crt
MQTT_TLS_KEY_PATH=./certs/client.key
MQTT_TLS_REJECT_UNAUTHORIZED=true

# Authentication
MQTT_USERNAME=
MQTT_PASSWORD=

# Connection Settings
MQTT_KEEPALIVE=60
MQTT_RECONNECT_PERIOD=5000
MQTT_CONNECT_TIMEOUT=30000
MQTT_MAX_RECONNECT_ATTEMPTS=10

# Session Settings
MQTT_CLEAN_SESSION=false
MQTT_SESSION_EXPIRY_INTERVAL=3600

# QoS Settings
MQTT_DEFAULT_QOS=1
MQTT_MAX_QOS=2

# Topic Configuration
MQTT_TOPIC_PREFIX=iot
MQTT_DEVICE_TOPIC_PATTERN=+/+/telemetry
MQTT_COMMAND_TOPIC_PATTERN=+/+/commands

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MESSAGES_PER_SECOND=100
RATE_LIMIT_BURST_SIZE=200
RATE_LIMIT_PAYLOAD_MAX_SIZE=1048576
RATE_LIMIT_CONNECTIONS_PER_TENANT=1000

# Connection Pool
CONNECTION_POOL_SIZE=10
CONNECTION_POOL_MIN_SIZE=2
CONNECTION_POOL_HEALTH_CHECK_INTERVAL=30000

# Circuit Breaker
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=60000
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=3

# Message Processing
MESSAGE_FORMAT_DEFAULT=json
MESSAGE_VALIDATION_ENABLED=true
MESSAGE_TRANSFORMATION_ENABLED=true
MESSAGE_ORDERING_ENABLED=true
BACKPRESSURE_ENABLED=true
BACKPRESSURE_HIGH_WATERMARK=10000
BACKPRESSURE_LOW_WATERMARK=5000

# Storage Configuration
STORAGE_HOT_ENABLED=true
STORAGE_HOT_TYPE=redis
STORAGE_HOT_URL=redis://localhost:6379
STORAGE_COLD_ENABLED=true
STORAGE_COLD_TYPE=mongodb
STORAGE_COLD_URL=mongodb://localhost:27017/iot-platform

# Redis Configuration (for queue and cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_CORRELATION_ID_ENABLED=true
LOG_OUTPUT_DIR=./logs

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_COLLECTION_INTERVAL=10000

# API Server
API_PORT=3000
API_HOST=0.0.0.0

# Node Environment
NODE_ENV=development
